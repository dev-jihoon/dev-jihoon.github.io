 {
 }
 
+
+// Orange web build: on touch devices an item view (list/table) that has an
+// editable current cell accepts input methods so typing starts editing; on
+// an iPad that brings up the on-screen keyboard whenever such a view is
+// tapped. Only real text editors should bring up the keyboard there.
+static bool webAcceptsInputMethod(bool accepted)
+{
+    if (!accepted)
+        return false;
+    static const bool touch =
+        emscripten::val::global("navigator")["maxTouchPoints"].as<int>() > 0;
+    if (!touch)
+        return true;
+    QObject *focus = QGuiApplication::focusObject();
+    return !(focus && focus->inherits("QAbstractItemView"));
+}
