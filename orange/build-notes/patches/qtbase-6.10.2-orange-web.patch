diff --git a/src/plugins/platforms/wasm/qwasmwindow.cpp b/src/plugins/platforms/wasm/qwasmwindow.cpp
index a3222e51..faeddbc8 100644
--- a/src/plugins/platforms/wasm/qwasmwindow.cpp
+++ b/src/plugins/platforms/wasm/qwasmwindow.cpp
@@ -97,7 +97,14 @@ QWasmWindow::QWasmWindow(QWindow *w, QWasmDeadKeySupport *deadKeySupport,
     // Set inputMode=none set to prevent the virtual keyboard from popping up.
     m_focusHelper["classList"].call<void>("add", emscripten::val("qt-window-focus-helper"));
     m_focusHelper.set("inputMode", std::string("none"));
-    m_focusHelper.call<void>("setAttribute", std::string("contenteditable"), std::string("true"));
+    // Orange web build: on touch devices (iPad) a focused contenteditable
+    // element brings up the keyboard bar even with inputMode=none, and the
+    // focus helper is focused on every tap. Make it focusable without being
+    // editable there; hardware key events still arrive.
+    if (emscripten::val::global("navigator")["maxTouchPoints"].as<int>() > 0)
+        m_focusHelper.call<void>("setAttribute", std::string("tabindex"), std::string("-1"));
+    else
+        m_focusHelper.call<void>("setAttribute", std::string("contenteditable"), std::string("true"));
     m_focusHelper["style"].set("position", "absolute");
     m_focusHelper["style"].set("left", 0);
     m_focusHelper["style"].set("top", 0);
