+// Orange web build: stand-in for the Windows-only QWindowsVistaStyle (Qt 6.8.1),
+// so that QWindows11Style can run in the browser. Metrics, hints and layout
+// follow the real style; the few elements it draws through the Windows theme
+// API (and QWindows11Style does not override) are drawn with QPainter in the
+// look of the Windows 10/11 Aero theme.
+
+#include "qwindowsvistastyle_p_p.h"
+#include <private/qstylehelper_p.h>
+#include <qpainter.h>
+#include <qpainterpath.h>
+
+QT_BEGIN_NAMESPACE
+
+bool QWindowsVistaStylePrivate::isItemViewDelegateLineEdit(const QWidget *widget)
+{
+    if (!widget)
+        return false;
+    const QWidget *parent1 = widget->parentWidget();
+    if (!parent1 || parent1->isWindow())
+        return false;
+    const QWidget *parent2 = parent1->parentWidget();
+    return parent2 && widget->inherits("QLineEdit")
+            && parent2->inherits("QAbstractItemView");
+}
+
+QTime QWindowsVistaStylePrivate::animationTime() const
+{
+    return QTime::currentTime();
+}
+
+QWindowsVistaStyle::QWindowsVistaStyle() : QWindowsStyle(*new QWindowsVistaStylePrivate) { }
+QWindowsVistaStyle::QWindowsVistaStyle(QWindowsVistaStylePrivate &dd) : QWindowsStyle(dd) { }
+QWindowsVistaStyle::~QWindowsVistaStyle() = default;
+
+// Explorer tree view glyph: a small chevron, pointing right when closed and
+// down when open.
+static void drawTreeGlyph(QPainter *p, const QRect &r, bool open, bool hot, bool rtl)
+{
+    p->save();
+    p->setRenderHint(QPainter::Antialiasing, true);
+    const QColor color = hot ? QColor(0x1c, 0xc4, 0xf7) : (open ? QColor(0x40, 0x40, 0x40)
+                                                              : QColor(0xa6, 0xa6, 0xa6));
+    QPen pen(color, 1.0);
+    pen.setCapStyle(Qt::FlatCap);
+    pen.setJoinStyle(Qt::MiterJoin);
+    p->setPen(pen);
+    const QPointF c = QRectF(r).center();
+    QPainterPath path;
+    if (open) {
+        path.moveTo(c + QPointF(-3.5, -1.75));
+        path.lineTo(c + QPointF(0, 1.75));
+        path.lineTo(c + QPointF(3.5, -1.75));
+    } else {
+        const qreal s = rtl ? -1 : 1;
+        path.moveTo(c + QPointF(-1.75 * s, -3.5));
+        path.lineTo(c + QPointF(1.75 * s, 0));
+        path.lineTo(c + QPointF(-1.75 * s, 3.5));
+    }
+    p->drawPath(path);
+    p->restore();
+}
+
+void QWindowsVistaStyle::drawPrimitive(PrimitiveElement element, const QStyleOption *option,
+                                       QPainter *painter, const QWidget *widget) const
+{
+    switch (element) {
+    case PE_IndicatorItemViewItemCheck: {
+        QStyleOptionButton button;
+        button.QStyleOption::operator=(*option);
+        button.state &= ~State_MouseOver;
+        proxy()->drawPrimitive(PE_IndicatorCheckBox, &button, painter, widget);
+        return;
+    }
+    case PE_IndicatorBranch:
+        if (option->state & State_Children) {
+            const int s = 16;
+            const QRect r(option->rect.center() - QPoint(s / 2 - 1, s / 2 - 1), QSize(s, s));
+            drawTreeGlyph(painter, r, option->state & State_Open,
+                          option->state & State_MouseOver, option->direction == Qt::RightToLeft);
+        }
+        return;
+    case PE_PanelMenuBar:
+    case PE_IndicatorDockWidgetResizeHandle:
+    case PE_FrameStatusBarItem:
+        return;
+    case PE_IndicatorToolBarSeparator: {
+        painter->save();
+        painter->setPen(QColor(0xd5, 0xdf, 0xe5));
+        const QRect r = option->rect;
+        if (option->state & State_Horizontal) {
+            const int x = r.center().x();
+            painter->drawLine(x, r.top() + 2, x, r.bottom() - 2);
+        } else {
+            const int y = r.center().y();
+            painter->drawLine(r.left() + 2, y, r.right() - 2, y);
+        }
+        painter->restore();
+        return;
+    }
+    case PE_PanelItemViewItem:
+        if (const auto *vopt = qstyleoption_cast<const QStyleOptionViewItem *>(option)) {
+            if (qobject_cast<const QTableView *>(widget))
+                break;   // tables keep the classic highlight, as in the real style
+            if (vopt->features & QStyleOptionViewItem::Alternate)
+                painter->fillRect(vopt->rect, vopt->palette.alternateBase());
+            if (vopt->backgroundBrush.style() != Qt::NoBrush) {
+                const QPointF oldBrushOrigin = painter->brushOrigin();
+                painter->setBrushOrigin(vopt->rect.topLeft());
+                painter->fillRect(vopt->rect, vopt->backgroundBrush);
+                painter->setBrushOrigin(oldBrushOrigin);
+            }
+            const bool selected = vopt->state & State_Selected;
+            const bool hover = vopt->state & State_MouseOver;
+            const bool active = vopt->state & State_Active;
+            if (selected || hover) {
+                QColor fill, border;
+                if (selected && !active) {
+                    fill = QColor(0xd9, 0xd9, 0xd9); border = fill;
+                } else if (selected) {
+                    fill = QColor(0xcc, 0xe8, 0xff); border = hover ? QColor(0x99, 0xd1, 0xff) : fill;
+                } else {
+                    fill = QColor(0xe5, 0xf3, 0xff); border = fill;
+                }
+                painter->save();
+                painter->setPen(border);
+                painter->setBrush(fill);
+                painter->drawRect(vopt->rect.adjusted(0, 0, -1, -1));
+                painter->restore();
+            }
+            return;
+        }
+        break;
+    default:
+        break;
+    }
+    QWindowsStyle::drawPrimitive(element, option, painter, widget);
+}
+
+void QWindowsVistaStyle::drawControl(ControlElement element, const QStyleOption *option,
+                                     QPainter *painter, const QWidget *widget) const
+{
+    switch (element) {
+    case CE_SizeGrip:
+        if (const auto *sg = qstyleoption_cast<const QStyleOptionSizeGrip *>(option)) {
+            // Status bar gripper: a triangle of small dots in the corner
+            painter->save();
+            const QRect r = option->rect;
+            const int step = 4;
+            const QColor dot(0xa0, 0xa0, 0xa0);
+            for (int i = 0; i < 3; ++i) {
+                for (int j = 0; j <= i; ++j) {
+                    int x = r.right() - 3 - j * step;
+                    int y = r.bottom() - 3 - (i - j) * step;
+                    if (sg->corner == Qt::BottomLeftCorner || sg->corner == Qt::TopLeftCorner)
+                        x = r.left() + 1 + j * step;
+                    if (sg->corner == Qt::TopRightCorner || sg->corner == Qt::TopLeftCorner)
+                        y = r.top() + 1 + (i - j) * step;
+                    painter->fillRect(QRect(x, y, 2, 2), dot);
+                }
+            }
+            painter->restore();
+            return;
+        }
+        break;
+    case CE_Splitter:
+        painter->eraseRect(option->rect);
+        return;
+    case CE_ToolBar:
+        if (const auto *toolbar = qstyleoption_cast<const QStyleOptionToolBar *>(option)) {
+            QPalette pal = option->palette;
+            pal.setColor(QPalette::Dark, option->palette.window().color().darker(130));
+            QStyleOptionToolBar copyOpt = *toolbar;
+            copyOpt.palette = pal;
+            QWindowsStyle::drawControl(element, &copyOpt, painter, widget);
+        }
+        return;
+    case CE_RubberBand:
+        if (qstyleoption_cast<const QStyleOptionRubberBand *>(option)) {
+            QColor highlight = option->palette.color(QPalette::Active, QPalette::Highlight);
+            painter->save();
+            painter->setPen(highlight.darker(120));
+            QColor dimHighlight(qMin(highlight.red() / 2 + 110, 255),
+                                qMin(highlight.green() / 2 + 110, 255),
+                                qMin(highlight.blue() / 2 + 110, 255),
+                                (widget && widget->isWindow()) ? 255 : 127);
+            painter->setBrush(dimHighlight);
+            painter->drawRect(option->rect.adjusted(0, 0, -1, -1));
+            painter->restore();
+            return;
+        }
+        break;
+    default:
+        break;
+    }
+    QWindowsStyle::drawControl(element, option, painter, widget);
+}
+
+void QWindowsVistaStyle::drawComplexControl(ComplexControl control, const QStyleOptionComplex *option,
+                                            QPainter *painter, const QWidget *widget) const
+{
+    QWindowsStyle::drawComplexControl(control, option, painter, widget);
+}
