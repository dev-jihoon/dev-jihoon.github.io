+// Orange web build: touch points can go stale when the browser delivers a
+// touch's pointerup/pointercancel to another element than the window that got
+// its pointerdown (seen on iPad Safari when a double tap opens a new window).
+// The stale point then stays "pressed" in that window, and Qt synthesizes every
+// later tap's mouse events at the stale position. Track which touch pointers
+// the browser still has down, and release the others in every window.
+namespace {
+QList<QWasmWindow *> &allWasmWindows()
+{
+    static QList<QWasmWindow *> windows;
+    return windows;
+}
+
+emscripten::val activeTouchPointers()
+{
+    static bool installed = false;
+    if (!installed) {
+        installed = true;
+        emscripten::val::global("eval")(std::string(R"JS((() => {
+            const s = new Set();
+            globalThis.__qtActiveTouches = s;
+            const opt = { capture: true, passive: true };
+            const on = (t, f) => window.addEventListener(t, f, opt);
+            on("pointerdown", (e) => {
+                if (e.pointerType !== "touch") return;
+                if (e.isPrimary) s.clear();   // first finger of a new gesture
+                s.add(e.pointerId);
+            });
+            const off = (e) => { if (e.pointerType === "touch") s.delete(e.pointerId); };
+            on("pointerup", off);
+            on("pointercancel", off);
+        })())JS"));
+    }
+    return emscripten::val::global("__qtActiveTouches");
+}
+} // namespace
+
+void QWasmWindow::releaseStaleTouchPoints(int currentPointerId)
+{
+    if (m_pointerIdToTouchPoints.isEmpty())
+        return;
+    emscripten::val active = activeTouchPointers();
+    QList<int> stale;
+    for (auto it = m_pointerIdToTouchPoints.cbegin(); it != m_pointerIdToTouchPoints.cend(); ++it) {
+        if (it.key() != currentPointerId && !active.call<bool>("has", it.key()))
+            stale.append(it.key());
+    }
+    if (stale.isEmpty())
+        return;
+    QList<QWindowSystemInterface::TouchPoint> points;
+    for (auto it = m_pointerIdToTouchPoints.cbegin(); it != m_pointerIdToTouchPoints.cend(); ++it) {
+        QWindowSystemInterface::TouchPoint p = it.value();
+        p.state = stale.contains(it.key()) ? QEventPoint::State::Released
+                                           : QEventPoint::State::Stationary;
+        points.append(p);
+    }
+    for (int id : stale)
+        m_pointerIdToTouchPoints.remove(id);
+    QWindowSystemInterface::handleTouchEvent(window(), QWasmIntegration::getTimestamp(),
+                                             platformScreen()->touchDevice(), points,
+                                             Qt::NoModifier);
+}
